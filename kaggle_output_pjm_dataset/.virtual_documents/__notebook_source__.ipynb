AVAILABLE = {}
def _try(name, stmt):
    try:
        exec(stmt, globals()); AVAILABLE[name] = True
    except Exception as e:
        AVAILABLE[name] = False; print(f"  [skip] {name}: {type(e).__name__}: {str(e)[:80]}")
def _preflight(lib, fit_code, hint):
    """Import + tiny fit in a SEPARATE process (after importing torch, like the notebook does).
    A native crash/hang then only kills the subprocess — the kernel survives and the model is skipped."""
    code = "import torch, numpy as np\n" + fit_code
    try:
        r = subprocess.run([sys.executable, '-c', code], capture_output=True, text=True, timeout=120, env=os.environ.copy())
        if r.returncode == 0: return True
        last = (r.stderr or r.stdout or f'exit code {r.returncode}').strip().splitlines()
        print(f"  [skip] {lib}: preflight failed ({last[-1][:140] if last else r.returncode}).  Fix: {hint}")
    except subprocess.TimeoutExpired:
        print(f"  [skip] {lib}: preflight HUNG for 120s (OpenMP deadlock).  Fix: {hint}")
    return False
